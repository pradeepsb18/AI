# 8 Puzzle using DFS

def print_board(state):
    for i in range(0, 9, 3):
        print(state[i], state[i + 1], state[i + 2])
    print()


def get_moves(state):
    moves = []

    blank = state.index(0)
    row = blank // 3
    col = blank % 3

    # Up
    if row > 0:
        new_state = list(state)
        new_state[blank], new_state[blank - 3] = \
            new_state[blank - 3], new_state[blank]
        moves.append(tuple(new_state))

    # Down
    if row < 2:
        new_state = list(state)
        new_state[blank], new_state[blank + 3] = \
            new_state[blank + 3], new_state[blank]
        moves.append(tuple(new_state))

    # Left
    if col > 0:
        new_state = list(state)
        new_state[blank], new_state[blank - 1] = \
            new_state[blank - 1], new_state[blank]
        moves.append(tuple(new_state))

    # Right
    if col < 2:
        new_state = list(state)
        new_state[blank], new_state[blank + 1] = \
            new_state[blank + 1], new_state[blank]
        moves.append(tuple(new_state))

    return moves


def dfs(state, path, visited, depth, goal):

    if state == goal:
        return path

    # Stop searching after depth limit
    if depth == 0:
        return None

    visited.add(state)

    for next_state in get_moves(state):

        if next_state not in visited:

            result = dfs(
                next_state,
                path + [next_state],
                visited,
                depth - 1,
                goal
            )

            if result is not None:
                return result

    return None



print("Enter the initial board")
print("Use 0 for blank space")

board = []

for i in range(3):
    row = list(map(int, input("Enter row " + str(i + 1) + ": ").split()))
    board.extend(row)

start = tuple(board)




print("\nEnter the goal board")
print("Use 0 for blank space")

goal_board = []

for i in range(3):
    row = list(map(int, input("Enter goal row " + str(i + 1) + ": ").split()))
    goal_board.extend(row)

goal = tuple(goal_board)




print("\nInitial State:")
print_board(start)

print("Goal State:")
print_board(goal)




solution = None

# Try increasing depth limits
for limit in range(1, 31):

    solution = dfs(start, [start], set(), limit, goal)

    if solution is not None:
        break




if solution is None:

    print("No solution found within depth 30.")

else:

    print("Solution found!")
    print("Number of moves:", len(solution) - 1)
    print()

    for i, state in enumerate(solution):
        print("Step", i)
        print_board(state)
